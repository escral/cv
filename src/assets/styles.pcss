@import "tailwindcss";

:root {
    --color-secondary: #6b7280; /* Tailwind's gray-500 */
}

body {
    background: var(--color-slate-100);
    font-family: "Poppins", sans-serif;
}

.page {
    width: 210mm;
    min-height: 297mm;
    margin: 100px auto;
    background: #fff;
    overflow: hidden;
    position: relative;

    @media print {
        margin: 0 auto;
    }

    &::after {
        content: "";
        display: block;
        position: absolute;
        top: 297mm;
        left: 0;
        width: 100%;
        height: 2px;
        background: #ccc;
        pointer-events: none;
    }
}

@layer components {
    .cv {
        display: grid;
        grid-template-columns: 1fr 230px;

        &__header {
            grid-column: 1 / -1;
        }

        &__main {
            display: grid;
            gap: 0 2rem;
            padding: 1.5rem 1.6rem 2rem 2rem;
            position: relative;

            &::after {
                content: "";
                display: block;
                position: absolute;
                pointer-events: none;
                top: 2rem;
                bottom: 2rem;
                left: 100%;
                width: 2px;
                background: var(--color-slate-100);
            }
        }

        &__sidebar {
            padding: 1.5rem 0 2rem 1.8rem;
        }

        hr {
            border: none;
            border-top: 1px solid var(--color-slate-100);
            margin: 1.5rem 0;
        }
    }

    .header {
        color: #fff;
        padding: 2rem;
        background: var(--color-slate-800);
        background: linear-gradient(45deg, var(--color-slate-700), var(--color-slate-900));

        &__name {
            font-size: 2.5rem;
            font-weight: 500;
            line-height: 1;
        }

        &__title {
            font-size: 1.25rem;
            font-weight: 300;
            color: var(--color-slate-300);
        }
    }

    .contacts {
        margin-top: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        font-size: 0.875rem;
        color: var(--color-slate-300);

        svg {
            width: 1rem;
            height: 1rem;
            margin-right: 0.25rem;
            vertical-align: middle;
        }

        &__item {
            display: flex;
            align-items: center;
            white-space: nowrap;
        }
    }

    .section {
        &__title {
            font-size: 1.375rem;
            margin-bottom: 0.5rem;
            color: var(--color-slate-700);
            break-after: avoid;
            /*border-bottom: 2px solid var(--color-slate-100);*/
            /*padding-bottom: 0.25rem;*/
        }

        &__item {
            margin-bottom: 3rem;
            break-inside: avoid;

            &:last-child {
                margin-bottom: 0;
            }
        }
    }

    .sidebar {
        font-size: 0.875rem;

        &__section {
            margin-bottom: 2rem;
        }
    }

    .personal {
        &__item {
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
        }

        &__label {
            font-weight: 500;
            color: var(--color-secondary);
        }
    }

    .job {
        font-size: 0.875rem;

        &__header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        &__title {
            font-weight: 500;
        }

        &__company {
            font-size: 0.875rem;
            color: var(--color-secondary);
        }

        &__subtitle {
            font-weight: 500;
        }

        &__details {
            margin-top: 0.5rem;

            p {
                margin-bottom: 0.5rem;
            }

            b {
                font-weight: 600;
            }

            ul {
                list-style: disc;
                padding-left: 1.75rem;
            }
        }
    }


    .textblock {
        font-size: 0.875rem;
        margin-bottom: 1rem;

        &__header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        &__title {
            font-weight: 500;
        }

        &__details {
            p {
                margin-bottom: 0.5rem;
            }

            ul {
                list-style: disc;
                padding-left: 1.75rem;
            }
        }
    }
}
