@import "tailwindcss";

body {
    background: var(--color-slate-100);
    font-family: "Poppins", sans-serif;
}

.page {
    width: 210mm;
    min-height: 297mm;
    margin: 100px auto;
    background: #fff;
    overflow: hidden;
    position: relative;

    &::after {
        content: "";
        display: block;
        position: absolute;
        top: 297mm;
        left: 0;
        width: 100%;
        height: 2px;
        background: #ccc;
        pointer-events: none;
    }
}

@layer components {
    .cv {
        display: grid;
        grid-template-columns: 6fr 3fr;

        &__header {
            grid-column: 1 / -1;
        }

        &__main {
            display: grid;
            gap: 2rem;
            padding: 2rem;
            position: relative;

            &::after {
                content: "";
                display: block;
                position: absolute;
                pointer-events: none;
                top: 2rem;
                bottom: 2rem;
                left: 100%;
                width: 2px;
                background: var(--color-slate-100);
            }
        }

        &__sidebar {
            padding: 2rem;
        }
    }

    .header {
        color: #fff;
        padding: 2rem;
        background: var(--color-slate-800);
        background: linear-gradient(45deg, var(--color-slate-700), var(--color-slate-900));

        &__name {
            font-size: 2.5rem;
            font-weight: 500;
            line-height: 1;
        }

        &__title {
            font-size: 1.25rem;
            font-weight: 300;
            color: var(--color-slate-300);
        }
    }

    .contacts {
        margin-top: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        font-size: 0.875rem;
        color: var(--color-slate-300);

        svg {
            width: 1rem;
            height: 1rem;
            margin-right: 0.25rem;
            vertical-align: middle;
        }

        &__item {
            display: flex;
            align-items: center;
            white-space: nowrap;
        }
    }

    .section {
        &__title {
            font-size: 1.375rem;
            margin-bottom: 0.5rem;
            color: var(--color-slate-700);
            /*border-bottom: 2px solid var(--color-slate-100);*/
            /*padding-bottom: 0.25rem;*/
        }
    }

    .sidebar {
        &__section {
            margin-bottom: 2rem;
        }
    }

    .personal {
        &__item {
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
        }

        &__label {
            font-weight: 500;
            color: var(--color-gray-400);
        }
    }
}
